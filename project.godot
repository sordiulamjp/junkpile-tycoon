; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Junkpile Tycoon"
config/version="0.0.1"
run/main_scene="res://scenes/zone_map.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.102, 0.086, 0.078, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/icon.png"
config/icon="res://assets/icon.png"

[autoload]

Wallet="*res://autoload/wallet.gd"
Save="*res://autoload/save.gd"
AdManager="*res://ads/ad_manager.gd"
SfxPlayer="*res://systems/sfx_player.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=960
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
